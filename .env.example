# Copy to .env and fill in. .env is git-ignored and dockerignored; tokens
# must never appear in command lines (docker inspect / ps would leak them).

# Required: the public HTTPS URL MCP clients connect to. Its hostname is the
# Host/Origin allowlist entry that blocks DNS rebinding.
MCP_PUBLIC_URL=https://mcp.example.com

# Required: static bearer token. Minimum 32 characters.
# Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional overrides (defaults shown). Note: the Docker image CMD pins
# --host 0.0.0.0 --port 3000 (CLI flags win over these vars); set them only
# when you run the server outside the image or override its command.
# MCP_HTTP_HOST=127.0.0.1      # direct (non-Docker) runs should keep the loopback default
# MCP_HTTP_PORT=3000
# MCP_MAX_BODY_BYTES=16777216  # hard HTTP body cap; tool layer still limits notes to 5 MiB
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_ALLOW_UNAUTHENTICATED=1  # development only — never set on a public host
